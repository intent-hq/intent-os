#!/bin/sh
# Lock the screen and return once the lock is up. The PIN is the owner's
# Linux password, checked through PAM. hyprlock shows a clock and a PIN
# field; swaylock is the fallback if hyprlock cannot start.
pgrep -x hyprlock >/dev/null && exit 0
pgrep -x swaylock >/dev/null && exit 0
setsid hyprlock --config /usr/share/intent-os/hyprlock.conf >/dev/null 2>&1 &
pid=$!
sleep 1
kill -0 "$pid" 2>/dev/null && exit 0
exec swaylock -f --color 0b0b0c --indicator-idle-visible --show-failed-attempts \
  --inside-color 18181b --ring-color 3f3f46 --key-hl-color e4e4e7 --text-color e4e4e7
