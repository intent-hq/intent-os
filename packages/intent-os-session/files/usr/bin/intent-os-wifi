#!/bin/bash
# Wi-Fi picker for the top bar: a dropdown under the network item. Lists
# nearby networks, asks for a password only for new secured networks, and
# reports failures in a swaynag bar. Needs no terminal.
set -u

placement=("$@")
menu() { fuzzel --config=/usr/share/intent-os/fuzzel.ini --dmenu "${placement[@]}" "$@"; }
fail() { swaynag -t warning -m "$1" >/dev/null 2>&1 & }

pgrep -x fuzzel >/dev/null && exit 0

if [[ $(nmcli -t radio wifi 2>/dev/null) != enabled ]]; then
  pick=$(printf 'Turn Wi-Fi on\n' | menu --prompt 'Wi-Fi  ' --lines 1) || exit 0
  [[ -n $pick ]] && nmcli radio wifi on
  exit 0
fi

ssids=() secured=() labels=() profiles=()
fuzzel --config=/usr/share/intent-os/fuzzel.ini --dmenu "${placement[@]}" --prompt-only 'Scanning for Wi-Fi networks…' </dev/null >/dev/null &
scan_notice=$!
close_scan_notice() {
  kill "$scan_notice" 2>/dev/null || true
  wait "$scan_notice" 2>/dev/null || true
}
trap close_scan_notice EXIT
networks=$(nmcli --wait 15 -t -e no -f IN-USE,SIGNAL,SECURITY,SSID dev wifi list --rescan auto 2>/dev/null)
scan_status=$?
close_scan_notice
trap - EXIT
if (( scan_status != 0 )); then
  fail "Could not scan for Wi-Fi networks. Try again."
  exit 1
fi
saved_ssids=() saved_uuids=()
while IFS=: read -r uuid type; do
  [[ $type == 802-11-wireless ]] || continue
  saved_ssid=$(nmcli -g 802-11-wireless.ssid -e no connection show uuid "$uuid" 2>/dev/null) || continue
  [[ -n $saved_ssid ]] || continue
  saved_ssids+=("$saved_ssid")
  saved_uuids+=("$uuid")
done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null)

while IFS=: read -r inuse signal security ssid; do
  [[ -z $ssid ]] && continue
  for s in "${ssids[@]}"; do [[ $s == "$ssid" ]] && continue 2; done
  ssids+=("$ssid")
  profile=
  for i in "${!saved_ssids[@]}"; do
    if [[ ${saved_ssids[i]} == "$ssid" ]]; then
      profile=${saved_uuids[i]}
      break
    fi
  done
  profiles+=("$profile")
  secured+=("$([[ -n $security && $security != -- ]] && echo 1 || echo 0)")
  label="$ssid"
  [[ $inuse == '*' ]] && label="● $label"
  label+="    ${signal}%"
  if [[ -n $profile ]]; then
    label+="  ·  saved"
  elif [[ ${secured[-1]} == 1 ]]; then
    label+="  ·  secured"
  fi
  labels+=("$label")
done <<< "$networks"

labels+=("Turn Wi-Fi off")
index=$(printf '%s\n' "${labels[@]}" | menu --index --prompt 'Wi-Fi  ') || exit 0
[[ $index =~ ^[0-9]+$ ]] || exit 0

if (( index == ${#ssids[@]} )); then
  nmcli radio wifi off
  exit 0
fi

ssid=${ssids[$index]}
if [[ -n ${profiles[$index]} ]]; then
  nmcli connection up uuid "${profiles[$index]}" >/dev/null 2>&1 || fail "Could not connect to $ssid."
  exit 0
fi

if [[ ${secured[$index]} == 1 ]]; then
  pw=$(menu --password --prompt-only "Password for $ssid  " </dev/null) || exit 0
  [[ -n $pw ]] || exit 0
  if ! nmcli dev wifi connect "$ssid" password "$pw" >/dev/null 2>&1; then
    # Drop the failed profile, then retry with WPA2 only: Broadcom brcmfmac
    # (many Macs) fails on routers that offer WPA2 and WPA3 together.
    nmcli connection delete id "$ssid" >/dev/null 2>&1
    if ! { nmcli connection add type wifi con-name "$ssid" ssid "$ssid" \
             wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$pw" >/dev/null 2>&1 &&
           nmcli connection up id "$ssid" >/dev/null 2>&1; }; then
      nmcli connection delete id "$ssid" >/dev/null 2>&1
      fail "Could not connect to $ssid. Check the password and try again."
    fi
  fi
else
  nmcli dev wifi connect "$ssid" >/dev/null 2>&1 || fail "Could not connect to $ssid."
fi
