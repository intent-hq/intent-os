#!/bin/bash
# Install coding agents for Intent. Same commands Intent shows in its
# provider setup. Agents install into ~/.local, so OS rollback keeps them.
set -u

agents=(
  "Claude Code|claude|curl -fsSL https://claude.ai/install.sh | bash|claude"
  "Codex|codex|npm install -g @openai/codex|codex login"
  "OpenCode|opencode|curl -fsSL https://opencode.ai/install | bash|opencode auth login"
  "Auggie|auggie|npm install -g @augmentcode/auggie|auggie login"
  "Factory Droid|droid|curl -fsSL https://app.factory.ai/cli | sh|droid"
  "Grok|grok|npm install -g @xai-official/grok|grok"
)

menu() {
  local i name bin _
  printf '\n\033[1mInstall a coding agent\033[0m\n\n'
  for i in "${!agents[@]}"; do
    IFS='|' read -r name bin _ <<<"${agents[$i]}"
    if command -v "$bin" >/dev/null 2>&1; then
      printf '  %d) %-14s \033[2minstalled\033[0m\n' $((i + 1)) "$name"
    else
      printf '  %d) %s\n' $((i + 1)) "$name"
    fi
  done
  printf '\n'
}

while :; do
  menu
  read -rp "Number to install, Enter for a shell: " choice || exit 0
  [[ -z $choice ]] && exit 0
  if ! [[ $choice =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#agents[@]} )); then
    continue
  fi
  IFS='|' read -r name bin cmd login <<<"${agents[$((choice - 1))]}"
  printf '\n\033[2m$ %s\033[0m\n' "$cmd"
  if bash -c "$cmd"; then
    hash -r
    printf '\n\033[1m%s is installed.\033[0m Sign in now with: %s\n' "$name" "$login"
    read -rp "Sign in now? [Y/n] " yn
    [[ ${yn:-y} =~ ^[Yy] ]] && bash -lc "$login"
    printf '\nRestart Intent from the top bar if it does not see %s yet.\n' "$name"
  else
    printf '\n\033[31mInstall failed.\033[0m Check the network and try again.\n'
  fi
done
