# Intent OS kiosk session. No launcher, no app shortcuts.
font pango:Inter 10
default_border none
default_floating_border pixel 1
hide_edge_borders both
focus_follows_mouse no
xwayland enable

output * bg #0b0b0c solid_color

input type:touchpad {
  tap disabled
  natural_scroll enabled
  dwt enabled
  click_method clickfinger
}
input type:keyboard {
  repeat_delay 300
  repeat_rate 30
}

# Top-row keys. Volume and brightness also show the top bar briefly.
set $peek pkill -USR1 -f /usr/lib/intent-os/top-bar
bindsym --locked XF86MonBrightnessUp exec brightnessctl -q set +5% && $peek
bindsym --locked XF86MonBrightnessDown exec brightnessctl -q set 5%- && $peek
bindsym --locked XF86KbdBrightnessUp exec brightnessctl -q -d '*::kbd_backlight' set +10%
bindsym --locked XF86KbdBrightnessDown exec brightnessctl -q -d '*::kbd_backlight' set 10%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && $peek
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- && $peek
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle && $peek
# Play/pause, previous, next for whatever is playing (Intent's browser, for example).
bindsym --locked XF86AudioPlay exec playerctl play-pause
bindsym --locked XF86AudioPrev exec playerctl previous
bindsym --locked XF86AudioNext exec playerctl next
# Mission Control (F3) shows the top bar.
bindsym XF86LaunchA exec $peek
bindsym XF86Explorer exec $peek
bindsym Mod4+Control+q exec intent-os-lock
bindsym Mod4+Shift+3 exec intent-os-screenshot
bindsym Mod4+Shift+4 exec intent-os-screenshot region
bindsym Print exec intent-os-screenshot
bindsym Shift+Print exec intent-os-screenshot region


exec /usr/lib/intent-os/session-start
