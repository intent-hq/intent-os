# Intent OS kiosk session. No launcher, no app shortcuts.
font pango:Noto Sans 10
default_border none
default_floating_border pixel 1
hide_edge_borders both
focus_follows_mouse no
xwayland enable

output * bg #0b0b0c solid_color

input type:touchpad {
  tap enabled
  natural_scroll enabled
  dwt enabled
  click_method clickfinger
}
input type:keyboard {
  repeat_delay 300
  repeat_rate 30
}

bindsym --locked XF86MonBrightnessUp exec brightnessctl -q set +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl -q set 5%-
bindsym --locked XF86KbdBrightnessUp exec brightnessctl -q -d '*::kbd_backlight' set +10%
bindsym --locked XF86KbdBrightnessDown exec brightnessctl -q -d '*::kbd_backlight' set 10%-
bindsym --locked XF86AudioRaiseVolume exec wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym --locked XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym Mod4+Control+q exec intent-os-lock

bar {
  position top
  height 24
  font pango:Noto Sans, Symbols Nerd Font Mono 10
  status_command /usr/lib/intent-os/status-bar
  workspace_buttons no
  binding_mode_indicator no
  tray_output none
  status_padding 4
  status_edge_padding 10
  colors {
    background #0b0b0c
    statusline #d4d4d8
    separator #0b0b0c
  }
}

exec /usr/lib/intent-os/session-start
