// The owner (wheel) controls power and the two Intent OS helper units
// without a prompt, also from user services outside the seat session.
polkit.addRule(function (action, subject) {
  if (!subject.isInGroup("wheel")) {
    return polkit.Result.NOT_HANDLED;
  }
  if (action.id.indexOf("org.freedesktop.login1.reboot") === 0 ||
      action.id.indexOf("org.freedesktop.login1.power-off") === 0 ||
      action.id.indexOf("org.freedesktop.login1.suspend") === 0) {
    return polkit.Result.YES;
  }
  if (action.id === "org.freedesktop.systemd1.manage-units" &&
      action.lookup("verb") === "start" &&
      (action.lookup("unit") === "intent-os-boot-ok.service" ||
       action.lookup("unit") === "intent-os-intent-upgrade.service")) {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
