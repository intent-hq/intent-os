#!/bin/sh
# Seed the owner's self-updating Intent AppImage and its first-run prefs.
set -eu
app="$HOME/.local/lib/intent-os/Intent.AppImage"
if [ ! -x "$app" ]; then
  install -Dm755 /usr/share/intent-os/Intent.AppImage "$app"
fi
# An unclean shutdown can leave intentd's pidfile behind; after a reboot its
# pid may belong to another process and intentd refuses to start. No intentd
# runs before Intent starts it, so any pidfile here is stale.
pidfile="$HOME/.local/share/intentd/intentd.pid"
if [ -e "$pidfile" ] && ! pgrep -u "$(id -u)" -x intentd >/dev/null; then
  rm -f "$pidfile"
fi
dir="${XDG_CONFIG_HOME:-$HOME/.config}/intent-cloudlands"
prefs="$dir/local-prefs.json"
mkdir -p "$dir"
# Preserve preferences seeded by older OS releases at the previous path.
legacy="$HOME/.config/Intent/local-prefs.json"
if [ ! -s "$prefs" ] && [ -s "$legacy" ]; then
  cp "$legacy" "$prefs"
fi
[ -s "$prefs" ] || echo '{}' > "$prefs"
tmp=$(mktemp "$dir/.local-prefs.XXXXXX")
trap 'rm -f "$tmp"' EXIT HUP INT TERM
jq '
  {updateChannel: "alpha", menuBarAutoHide: true, dockEnabled: false} + .
' "$prefs" > "$tmp"
mv "$tmp" "$prefs"
