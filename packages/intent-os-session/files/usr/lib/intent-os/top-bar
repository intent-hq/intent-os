#!/usr/bin/python3
"""Intent OS top bar: network, battery, clock and device controls.

It takes no space. A 2 px strip waits at the top edge; when the pointer
touches it, the bar opens on top of Intent and closes once the pointer
leaves it. The menu button opens the device actions.
"""
import json
import os
from pathlib import Path
import signal as unix_signal
import subprocess
import struct
import time

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GtkLayerShell", "0.1")
from gi.repository import Gdk, GLib, Gtk, GtkLayerShell  # noqa: E402

HEIGHT = 28
TRIGGER = 2
CLOSE_DELAY_MS = 350

I_WIFI = ["\U000f092e", "\U000f091f", "\U000f0922", "\U000f0925", "\U000f0928"]
I_WIRED = "\U000f0200"
I_OFFLINE = "\U000f05aa"
I_BATTERY = ["\U000f007a", "\U000f007b", "\U000f007c", "\U000f007d", "\U000f007e",
             "\U000f007f", "\U000f0080", "\U000f0081", "\U000f0082", "\U000f0079"]
I_CHARGING = "\U000f0084"
I_BATTERY_ALERT = "\U000f0083"  # worn battery: replace it
I_VOLUME = ["\U000f057f", "\U000f0580", "\U000f057e"]  # low, medium, high
I_MUTED = "\U000f075f"
I_BRIGHTNESS = "\U000f00e0"
I_POWER = "\U000f0425"
I_MENU = "\U000f035c"
I_RESTART_INTENT = "\U000f0450"
I_REBOOT = "\U000f0709"
I_SLEEP = "\U000f04b2"
I_LOCK = "\U000f033e"
I_UNDO = "\U000f02da"
I_AWAKE = "\U000f0176"  # coffee: kept awake for a working agent
AWAKE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "intent-os-awake")
LAST_UPDATE = "/var/lib/intent-os/last-update"
PEEK_MS = 1500

# Semantic colors from https://intentapp.dev/design-system.md
PALETTES = {
    "light": ("#f0f0eb", "#ffffff", "#080808", "#525250", "#e1e1de", "#e5e5e5", "#717453"),
    "dark": ("#161616", "#272727", "#f0f0eb", "#babab7", "#3d3d3c", "#3d3d3c", "#ddec61"),
}

CSS = """
window { background: transparent; }
#bar, popover.power-menu { color: @content; font: 10pt "Inter", "Symbols Nerd Font Mono"; }
#bar { background: @canvas; border-bottom: 1px solid @edge; }
.brand { margin-left: 12px; font-weight: 600; }
.brand-mark { background-repeat: no-repeat; background-position: center; background-size: 16px; }
.item { padding: 0 8px; color: @muted; }
.button, .item.clickable { border-radius: 5px; }
.button { padding: 0 8px; color: @content; }
.button:hover, .item.clickable:hover { background: @hover; color: @content; }
.hint { color: @accent; }
popover.power-menu { background: @surface; border: 1px solid @edge; border-radius: 10px; }
.power-menu .button { padding: 5px 10px; }
"""


def style_bar(settings, provider):
    dark = settings.get_property("gtk-application-prefer-dark-theme")
    dark = dark or "dark" in settings.get_property("gtk-theme-name").lower()
    names = ("canvas", "surface", "content", "muted", "hover", "edge", "accent")
    colors = PALETTES["dark" if dark else "light"]
    tokens = "".join(f"@define-color {name} {value};\n" for name, value in zip(names, colors))
    mark = "white" if dark else "black"
    brand = f'.brand-mark {{ background-image: url("/usr/share/intent-os/intent-mark-{mark}.svg"); }}'
    provider.load_from_data((tokens + CSS + brand).encode())


# Menus and prompts opened from the bar (Wi-Fi picker, confirmations). The bar
# stays open until they close.
held = []


def run(*cmd, hold=False):
    proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                            stderr=subprocess.DEVNULL, start_new_session=True)
    if hold:
        held.append(proc)


def holding():
    held[:] = [proc for proc in held if proc.poll() is None]
    return bool(held)


def output(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""

def app_version(archive):
    with archive.open("rb") as file:
        _, header_size, _, json_size = struct.unpack("<4I", file.read(16))
        if not 0 < json_size <= header_size <= 32 * 1024 * 1024:
            return ""
        package = json.loads(file.read(json_size))["files"]["package.json"]
        if not 0 < package["size"] <= 1024 * 1024:
            return ""
        file.seek(8 + header_size + int(package["offset"]))
        return json.loads(file.read(package["size"]))["version"]


def versions():
    try:
        os_version = Path("/var/lib/intent-os/applied-build").read_text().strip()
    except OSError:
        os_version = ""
    if not os_version:
        os_version = output("pacman", "-Q", "intent-os-session").partition(" ")[2].strip()
    app = daemon = ""
    pid = output("pgrep", "-o", "-u", str(os.getuid()), "-x", "intent").strip()
    if pid.isdecimal():
        try:
            exe = Path(f"/proc/{pid}/exe").resolve(strict=True)
            app = app_version(exe.parent / "resources/app.asar")
        except (OSError, ValueError, KeyError, TypeError, struct.error):
            pass
    try:
        pid = (Path.home() / ".local/share/intentd/intentd.pid").read_text().strip()
        if pid.isdecimal():
            exe = Path(f"/proc/{pid}/exe").resolve(strict=True)
            if exe.name == "intentd":
                daemon = output(str(exe), "--version").strip().removeprefix("intentd ")
    except OSError:
        pass
    return os_version, app, daemon



def network_text():
    for line in output("nmcli", "-t", "-f", "NAME,TYPE", "connection", "show", "--active").splitlines():
        name, _, kind = line.rpartition(":")
        if kind == "802-11-wireless":
            signal = 0
            for row in output("nmcli", "-t", "-f", "IN-USE,SIGNAL", "dev", "wifi", "list",
                              "--rescan", "no").splitlines():
                if row.startswith("*:"):
                    signal = int(row[2:] or 0)
                    break
            return f"{I_WIFI[min(4, (signal + 24) // 25)]}  {name.replace(chr(92) + ':', ':')}"
        if kind == "802-3-ethernet":
            return I_WIRED
    return I_OFFLINE


def read_int(path):
    try:
        with open(path) as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


def battery_percent(path):
    """Charge as a percentage. A worn battery's own "full" can be tiny, so
    the kernel's capacity can pass 100% (or swing wildly); when the battery
    holds under half its design charge, measure against the design instead.
    Returns (percent, worn)."""
    for kind in ("energy", "charge"):
        now = read_int(f"{path}/{kind}_now")
        full = read_int(f"{path}/{kind}_full")
        design = read_int(f"{path}/{kind}_full_design")
        if now is not None and full and design:
            worn = full < design // 2
            pct = round(100 * now / (design if worn else full))
            return max(0, min(100, pct)), worn
    cap = read_int(f"{path}/capacity")
    return (None, False) if cap is None else (max(0, min(100, cap)), False)


def volume_state():
    """(percent, muted) of the default output, or None without audio."""
    out = output("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@").split()
    if len(out) < 2 or out[0] != "Volume:":
        return None
    try:
        return round(float(out[1]) * 100), "[MUTED]" in out
    except ValueError:
        return None


def volume_text():
    state = volume_state()
    if state is None:
        return ""
    pct, muted = state
    if muted or pct == 0:
        return f"{I_MUTED} {pct}%"
    return f"{I_VOLUME[min(2, pct // 34)]} {pct}%"


def set_volume(change):
    subprocess.run(["wpctl", "set-volume", "-l", "1.0", "@DEFAULT_AUDIO_SINK@", change],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)


def last_update_date():
    """When the last Intent OS update was installed, or None if none can be undone."""
    try:
        with open(LAST_UPDATE) as f:
            for line in f:
                if line.startswith("DATE="):
                    return line.strip()[5:] or "recently"
    except OSError:
        return None
    return "recently"


def battery_text():
    base = "/sys/class/power_supply"
    for ps in sorted(os.listdir(base)) if os.path.isdir(base) else []:
        path = f"{base}/{ps}"
        try:
            with open(f"{path}/type") as f:
                if f.read().strip() != "Battery":
                    continue
            with open(f"{path}/status") as f:
                status = f.read().strip()
        except OSError:
            continue
        cap, worn = battery_percent(path)
        if cap is None:
            continue
        if worn:
            return f"{I_BATTERY_ALERT} {cap}%"
        if status == "Charging":
            return f"{I_CHARGING} {cap}%"
        return f"{I_BATTERY[max(0, min(9, cap // 10 - 1))]} {cap}%"
    return ""


class TopBar(Gtk.Window):
    def __init__(self):
        super().__init__()
        self.close_timer = 0
        self.set_app_paintable(True)
        visual = self.get_screen().get_rgba_visual()
        if visual:
            self.set_visual(visual)

        GtkLayerShell.init_for_window(self)
        GtkLayerShell.set_namespace(self, "intent-os-top-bar")
        GtkLayerShell.set_layer(self, GtkLayerShell.Layer.OVERLAY)
        for edge in (GtkLayerShell.Edge.TOP, GtkLayerShell.Edge.LEFT, GtkLayerShell.Edge.RIGHT):
            GtkLayerShell.set_anchor(self, edge, True)
        GtkLayerShell.set_exclusive_zone(self, 0)
        GtkLayerShell.set_keyboard_mode(self, GtkLayerShell.KeyboardMode.NONE)

        provider = Gtk.CssProvider()
        settings = self.get_settings()
        style_bar(settings, provider)
        for name in ("gtk-application-prefer-dark-theme", "gtk-theme-name"):
            settings.connect(f"notify::{name}", lambda *_: style_bar(settings, provider))
        Gtk.StyleContext.add_provider_for_screen(
            self.get_screen(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self.bar = Gtk.Box(spacing=4, name="bar")
        self.bar.set_size_request(-1, HEIGHT)
        brand = Gtk.Box(spacing=6)
        brand.get_style_context().add_class("brand")
        mark = Gtk.Box()
        mark.set_size_request(16, 16)
        mark.get_style_context().add_class("brand-mark")
        brand.pack_start(mark, False, False, 0)
        brand.pack_start(Gtk.Label(label="IntentOS"), False, False, 0)
        brand_button = Gtk.EventBox()
        brand_button.add(brand)
        brand_button.get_style_context().add_class("button")
        brand_button.connect("button-press-event", lambda *_: self.open_versions())
        self.bar.pack_start(brand_button, False, False, 0)
        self.bar.pack_start(Gtk.Box(), True, True, 0)
        self.network = self.item(self.open_wifi)
        self.awake = self.item(None)
        self.awake.set_text(I_AWAKE)
        self.awake.get_parent().set_tooltip_text("An agent is working: the device stays awake")
        self.brightness = self.item(self.refresh_brightness)
        self.volume = self.item(self.toggle_mute)
        volume_box = self.volume.get_parent()
        volume_box.add_events(Gdk.EventMask.SCROLL_MASK | Gdk.EventMask.SMOOTH_SCROLL_MASK)
        volume_box.connect("scroll-event", self.on_volume_scroll)
        self.battery = self.item(None)
        self.clock = self.item(None)
        gap = Gtk.Box()
        gap.set_size_request(8, -1)
        self.bar.pack_start(gap, False, False, 0)
        self.power = self.text_button(self.bar, self.open_power, I_MENU)
        self.power.get_accessible().set_name("Device actions")
        edge = Gtk.Box()
        edge.set_size_request(6, -1)
        self.bar.pack_start(edge, False, False, 0)

        self.power_menu = Gtk.Popover.new(self.power)
        self.power_menu.set_modal(False)
        self.power_menu.set_position(Gtk.PositionType.BOTTOM)
        self.power_menu.set_constrain_to(Gtk.PopoverConstraint.NONE)
        self.power_menu.get_style_context().add_class("power-menu")
        self.power_menu.connect("closed", self.power_closed)
        self.power_surface = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        dismiss_area = Gtk.EventBox()
        dismiss_area.set_visible_window(False)
        dismiss_area.connect("button-press-event", lambda *_: self.dismiss_power())
        self.power_surface.pack_end(dismiss_area, True, True, 0)
        self.bar.connect("button-press-event", lambda *_: self.dismiss_power())
        self.power_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin=4)
        self.power_menu.add(self.power_box)
        self.power_item(I_RESTART_INTENT, "Restart Intent", lambda: run(
            "systemctl", "--user", "restart", "intent.service"))
        self.power_item(I_LOCK, "Lock", lambda: run("/usr/bin/intent-os-lock"))
        self.power_item(I_SLEEP, "Sleep", lambda: run("systemctl", "suspend"))
        self.reboot = self.power_item(I_REBOOT, "Restart device", lambda: self.ask(
            "Restart this device?", "Restart", ["systemctl", "reboot"]))
        self.power_item(I_POWER, "Shut down", lambda: self.ask(
            "Shut down this device?", "Shut down", ["systemctl", "poweroff"]))
        self.undo = self.power_item(I_UNDO, "Undo update", self.confirm_undo)
        self.active_menu = None
        self.version_menu = Gtk.Popover.new(brand_button)
        self.version_menu.set_modal(False)
        self.version_menu.set_position(Gtk.PositionType.BOTTOM)
        self.version_menu.set_constrain_to(Gtk.PopoverConstraint.NONE)
        self.version_menu.get_style_context().add_class("power-menu")
        self.version_menu.connect("closed", self.power_closed)
        grid = Gtk.Grid(column_spacing=16, row_spacing=6, margin=12)
        self.version_values = []
        for row, name in enumerate(("Intent OS", "Intent app", "intentd")):
            grid.attach(Gtk.Label(label=name, xalign=0), 0, row, 1, 1)
            value = Gtk.Label(xalign=0, selectable=True)
            grid.attach(value, 1, row, 1, 1)
            self.version_values.append(value)
        self.version_menu.add(grid)

        # Confirmations replace the bar's contents in place (a separate swaynag
        # bar collided with this overlay and pushed it down the screen).
        self.asking = None
        self.ask_box = Gtk.Box(spacing=4, name="bar")
        self.ask_box.set_size_request(-1, HEIGHT)
        self.ask_box.pack_start(Gtk.Box(), True, True, 0)
        self.ask_label = Gtk.Label()
        self.ask_label.set_margin_end(12)
        self.ask_box.pack_start(self.ask_label, False, False, 0)
        self.ask_yes = self.text_button(self.ask_box, lambda: self.answer(True))
        self.text_button(self.ask_box, lambda: self.answer(False)).get_child().set_text("Cancel")
        edge2 = Gtk.Box()
        edge2.set_size_request(6, -1)
        self.ask_box.pack_start(edge2, False, False, 0)

        self.strip = Gtk.EventBox()
        self.strip.set_size_request(-1, TRIGGER)
        self.add(self.strip)
        self.strip.connect("enter-notify-event", lambda *_: self.open())
        self.connect("enter-notify-event", lambda *_: self.cancel_close())
        self.connect("leave-notify-event", self.on_leave)

        self.refresh()
        GLib.timeout_add_seconds(5, self.refresh)
        # The volume and brightness keys send SIGUSR1: show the bar briefly.
        GLib.unix_signal_add(GLib.PRIORITY_DEFAULT, unix_signal.SIGUSR1, self.peek)

    def open_wifi(self):
        control = self.network.get_parent()
        bar_width = self.bar.get_allocated_width()
        right = control.get_allocation().x + control.get_allocated_width()
        margin = max(8, min(bar_width - right, bar_width - 480))
        run("intent-os-wifi", "--x-margin", str(margin), hold=True)

    def item(self, action):
        box = Gtk.EventBox()
        label = Gtk.Label()
        # GTK ignores CSS padding on an EventBox; space the label itself.
        label.set_margin_start(10)
        label.set_margin_end(10)
        box.add(label)
        box.get_style_context().add_class("item")
        if action:
            box.get_style_context().add_class("clickable")
            box.connect("button-press-event", lambda *_: action())
        self.bar.pack_start(box, False, False, 0)
        return label

    def text_button(self, box_parent, action, text=""):
        box = Gtk.EventBox()
        label = Gtk.Label(label=text)
        label.set_margin_start(12)
        label.set_margin_end(12)
        box.add(label)
        box.get_style_context().add_class("button")
        box.connect("button-press-event", lambda *_: action())
        box_parent.pack_start(box, False, False, 0)
        return box

    def open_power(self):
        self.undo.set_visible(last_update_date() is not None)
        return self.open_menu(self.power_menu)

    def open_versions(self):
        if self.active_menu is None:
            for label, version in zip(self.version_values, versions()):
                label.set_text(version or "Unavailable")
        return self.open_menu(self.version_menu)

    def open_menu(self, menu):
        if self.active_menu is not None:
            return self.dismiss_power()
        self.active_menu = menu
        self.cancel_close()
        self.remove(self.bar)
        self.power_surface.pack_start(self.bar, False, False, 0)
        self.add(self.power_surface)
        self.power_surface.show_all()
        self.fix_visibility()
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, True)
        menu.get_child().show_all()
        if menu is self.power_menu:
            self.undo.set_visible(last_update_date() is not None)
        menu.popup()
        return True

    def dismiss_power(self):
        if self.active_menu is None:
            return False
        self.active_menu.popdown()
        return True

    def power_item(self, icon, label, action):
        button = Gtk.Button()
        button.set_relief(Gtk.ReliefStyle.NONE)
        button.get_style_context().add_class("button")
        row = Gtk.Box(spacing=10)
        row.pack_start(Gtk.Label(label=icon), False, False, 0)
        row.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)
        button.add(row)
        def activate(_button):
            self.power_menu.popdown()
            action()

        button.connect("clicked", activate)
        self.power_box.pack_start(button, False, False, 0)
        return button

    def power_closed(self, _menu):
        self.active_menu = None
        GtkLayerShell.set_anchor(self, GtkLayerShell.Edge.BOTTOM, False)
        self.power_surface.remove(self.bar)
        self.back_to_bar()
        self.resize(1, HEIGHT)
        self.cancel_close()
        self.close_timer = GLib.timeout_add(CLOSE_DELAY_MS, self.close)

    def back_to_bar(self):
        self.remove(self.get_child())
        self.add(self.bar)
        self.bar.show_all()
        self.fix_visibility()

    def ask(self, message, label, command):
        self.asking = command
        self.ask_label.set_text(message)
        self.ask_yes.get_child().set_text(label)
        self.cancel_close()
        child = self.get_child()
        if child is not self.ask_box:
            self.remove(child)
            self.add(self.ask_box)
        self.ask_box.show_all()

    def answer(self, yes):
        command, self.asking = self.asking, None
        self.back_to_bar()
        if yes and command:
            run(*command)

    def confirm_undo(self):
        when = last_update_date()
        if when:
            self.ask(f"Undo the Intent OS update from {when}? The device restarts.",
                     "Undo and restart", ["sudo", "-n", "/usr/lib/intent-os/undo-update"])

    def toggle_mute(self):
        subprocess.run(["wpctl", "set-mute", "@DEFAULT_AUDIO_SINK@", "toggle"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        self.refresh_volume()

    def on_volume_scroll(self, _widget, event):
        up = event.direction == Gdk.ScrollDirection.UP
        if event.direction == Gdk.ScrollDirection.SMOOTH:
            ok, _dx, dy = event.get_scroll_deltas()
            if not ok or dy == 0:
                return True
            up = dy < 0
        elif event.direction != Gdk.ScrollDirection.DOWN and not up:
            return True
        set_volume("5%+" if up else "5%-")
        self.refresh_volume()
        return True

    def refresh_volume(self):
        text = volume_text()
        self.volume.set_text(text)
        self.volume.get_parent().set_visible(bool(text))

    def refresh_brightness(self):
        text = ""
        for device in sorted(Path("/sys/class/backlight").glob("*")):
            level = read_int(device / "actual_brightness")
            maximum = read_int(device / "max_brightness")
            if level is not None and maximum:
                text = f"{I_BRIGHTNESS} {round(100 * level / maximum)}%"
                break
        self.brightness.set_text(text)
        self.brightness.get_parent().set_visible(bool(text))

    def peek(self):
        self.refresh_brightness()
        self.refresh_volume()
        self.open(refresh=False)
        self.cancel_close()
        self.close_timer = GLib.timeout_add(PEEK_MS, self.close)
        return True  # keep the signal handler

    def refresh(self):
        self.network.set_text(network_text())
        self.refresh_brightness()
        self.refresh_volume()
        bat = battery_text()
        self.battery.set_text(bat)
        self.battery.get_parent().set_visible(bool(bat))
        self.clock.set_text(time.strftime("%a %-d %b  %H:%M"))
        self.undo.set_visible(last_update_date() is not None)
        self.awake.get_parent().set_visible(os.path.exists(AWAKE))
        for button in (self.power, self.reboot):
            ctx = button.get_style_context()
            if os.path.exists("/run/intent-os/reboot-required"):
                ctx.add_class("hint")
            else:
                ctx.remove_class("hint")
        return True

    def open(self, refresh=True):
        self.cancel_close()
        if self.get_child() is not self.strip:
            return
        if refresh:
            self.refresh()
        self.remove(self.strip)
        self.add(self.bar)
        self.bar.show_all()
        self.fix_visibility()

    def fix_visibility(self):
        self.brightness.get_parent().set_visible(bool(self.brightness.get_text()))
        self.battery.get_parent().set_visible(bool(self.battery.get_text()))
        self.volume.get_parent().set_visible(bool(self.volume.get_text()))
        self.awake.get_parent().set_visible(os.path.exists(AWAKE))

    def on_leave(self, _widget, event):
        # Moving onto a child of the bar is not leaving it.
        if event.detail != Gdk.NotifyType.INFERIOR:
            self.cancel_close()
            self.close_timer = GLib.timeout_add(CLOSE_DELAY_MS, self.close)

    def cancel_close(self):
        if self.close_timer:
            GLib.source_remove(self.close_timer)
            self.close_timer = 0

    def close(self):
        if holding() or self.asking or self.active_menu is not None:
            return True  # check again once the menu or question closes
        self.close_timer = 0
        if self.get_child() is not self.strip:
            self.remove(self.get_child())
            self.add(self.strip)
            self.strip.show()
            self.resize(1, TRIGGER)
        return False


if __name__ == "__main__":
    bar = TopBar()
    bar.connect("destroy", Gtk.main_quit)
    bar.show_all()
    Gtk.main()
