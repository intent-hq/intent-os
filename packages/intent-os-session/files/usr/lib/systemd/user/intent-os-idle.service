[Unit]
Description=Lock on idle and before sleep
PartOf=intent-os-session.target

[Service]
ExecStart=/usr/bin/swayidle -w \
  idlehint 300 \
  timeout 300 /usr/bin/intent-os-lock \
  timeout 600 'swaymsg "output * power off"' resume 'swaymsg "output * power on"' \
  before-sleep /usr/bin/intent-os-lock
Restart=always
RestartSec=2
