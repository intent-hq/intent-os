# The released Intent AppImage, used only to seed the owner's own copy at
# ~/.local/lib/intent-os/Intent.AppImage. Intent then updates that copy
# itself (alpha channel by default). CI bumps pkgver and sha256sums daily
# from the cloudlands-releases alpha feed.
pkgname=intent-appimage
pkgver=2.391.0
pkgrel=1
pkgdesc="Intent AppImage (seed for the self-updating owner copy)"
arch=(x86_64 aarch64)
url="https://intentapp.dev/"
license=(Apache-2.0)
depends=(fuse2 gtk3 nss libnotify libxss libxtst xdg-utils at-spi2-core libsecret alsa-lib git)
options=(!strip !debug)
_base="https://github.com/intent-hq/cloudlands-releases/releases/download/v${pkgver}"
source_x86_64=("Intent-${pkgver}.AppImage::${_base}/Intent-${pkgver}.AppImage")
source_aarch64=("Intent-${pkgver}.AppImage::${_base}/Intent-${pkgver}-arm64.AppImage")
noextract=("Intent-${pkgver}.AppImage")
sha256sums_x86_64=('563e9cf94e504e6789825aae389c73b0a3c8720d6cd6b638ae7c7d27ee33a78b')
sha256sums_aarch64=('60dc0add3170d071f2fee170bac2b0f4d6f0d833dce4fc878998cbe835d449f9')

package() {
  install -Dm755 "Intent-${pkgver}.AppImage" "$pkgdir/usr/share/intent-os/Intent.AppImage"
  echo "$pkgver" > "$pkgdir/usr/share/intent-os/Intent.AppImage.version"
}
