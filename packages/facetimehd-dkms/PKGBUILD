# FaceTime HD (Broadcom 1570) PCIe camera driver, built by DKMS for each
# kernel. From the AUR package of the same name (GPL-2.0). The firmware is
# Apple's: intent-os-hw-mac downloads it on the device.
pkgname=facetimehd-dkms
pkgver=0.7.2
pkgrel=1
pkgdesc='Reverse engineered Linux driver for the FacetimeHD (Broadcom 1570) PCIe webcam'
url='https://github.com/patjak/facetimehd'
license=('GPL-2.0-only')
arch=('any')
depends=('dkms')
makedepends=('git')
provides=('bcwc-pcie-dkms')
conflicts=('bcwc-pcie-dkms')
source=("facetimehd::git+https://github.com/patjak/facetimehd.git#tag=$pkgver")
sha256sums=('43344654bcdaa7de115f5393bc737117e8fda6665eef9cdcabd1dceaa1687366')

prepare() {
  sed -E -e '/^(CLEAN|MODULES_CONF)/d' -i facetimehd/dkms.conf
}

package() {
  cd facetimehd
  local f
  for f in dkms.conf Makefile *.[ch]; do
    install -Dm644 "$f" "$pkgdir/usr/src/facetimehd-$pkgver/$f"
  done
}
