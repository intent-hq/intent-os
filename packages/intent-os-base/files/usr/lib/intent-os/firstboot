#!/bin/bash
# First boot of a prebuilt image (for example the arm64 VM image): set the
# owner's PIN and time zone on the console before the session starts.
set -u
flag=/var/lib/intent-os/firstboot
[[ -e $flag ]] || exit 0
echo "INTENT_OS_FIRSTBOOT" > /dev/kmsg 2>/dev/null || true
clear
printf '\n\033[1mWelcome to Intent OS\033[0m\n\n'
echo "Choose a PIN (4 to 12 digits). You enter it to unlock this device and for sudo."
while :; do
  read -rsp "PIN: " a; echo
  [[ $a =~ ^[0-9]{4,12}$ ]] || { echo "Use 4 to 12 digits."; continue; }
  read -rsp "Confirm PIN: " b; echo
  [[ $a == "$b" ]] && break
  echo "The PINs do not match."
done
printf 'intent:%s\n' "$a" | chpasswd
while :; do
  read -rp "Time zone, for example America/Los_Angeles [UTC]: " tz
  tz=${tz:-UTC}
  [[ -f /usr/share/zoneinfo/$tz ]] && break
  echo "Unknown time zone."
done
timedatectl set-timezone "$tz" 2>/dev/null || ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
rm -f "$flag"
systemctl disable intent-os-firstboot.service 2>/dev/null || true
echo "Starting Intent..."
