#!/bin/bash
# Move this device to the newest channel that passed the Intent OS boot test.
# Runs only when the owner is idle and on AC power, unless called with --now.
# Intent is not updated here: it updates its own AppImage in the app.
set -euo pipefail

CHANNEL_URL=${INTENT_OS_CHANNEL_URL:-https://github.com/intent-hq/intent-os/releases/download/channel/channel.env}
STATE=/var/lib/intent-os
MIRRORLIST=/etc/pacman.d/intent-os-mirrorlist

log() { echo "intent-os-update: $*"; }

on_ac() {
  local ps mains=0
  for ps in /sys/class/power_supply/*; do
    [[ $(cat "$ps/type" 2>/dev/null) == Mains ]] || continue
    mains=1
    [[ $(cat "$ps/online" 2>/dev/null) == 1 ]] && return 0
  done
  (( mains == 0 ))
}

idle() {
  local s
  for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do
    [[ $(loginctl show-session "$s" -p Class --value) == user ]] || continue
    [[ $(loginctl show-session "$s" -p IdleHint --value) == yes ]] || return 1
  done
  return 0
}

if [[ ${1:-} != --now ]]; then
  on_ac || { log "on battery; skip"; exit 0; }
  idle || { log "owner is active; skip"; exit 0; }
fi

# Serialize the timer and menu so only one updater can change the package repo.
exec 9>/run/intent-os-update.lock
flock 9

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
if ! curl -fsSL --max-time 30 "$CHANNEL_URL" -o "$tmp"; then
  log "channel not reachable; skip"
  exit 0
fi
date=$(sed -n 's/^ARCHIVE_DATE=\([0-9]\{4\}\/[0-9]\{2\}\/[0-9]\{2\}\)$/\1/p' "$tmp")
build=$(sed -n 's/^BUILD_ID=\([A-Za-z0-9._-]\{1,64\}\)$/\1/p' "$tmp")
[[ -n $date && -n $build ]] || { log "invalid channel file"; exit 1; }

current=$(sed -n 's|^Server = https://archive.archlinux.org/repos/\([0-9/]*\)/.*|\1|p' "$MIRRORLIST" | head -n1)
if [[ -n $current && $date < $current ]]; then
  log "channel $date is older than $current; skip"
  exit 0
fi
if [[ $(cat "$STATE/applied-build" 2>/dev/null) == "$build" && ! -e $STATE/retry ]]; then
  exit 0
fi
# The owner undid this build (top bar): wait for a newer one.
if [[ $(cat "$STATE/skip-build" 2>/dev/null) == "$build" ]]; then
  log "build $build was undone; waiting for a newer build"
  exit 0
fi

log "updating to $date (build $build)"
# Arch Linux ARM has no archive; aarch64 keeps its normal mirrors.
if [[ $(uname -m) == x86_64 ]]; then
  # shellcheck disable=SC2016 # pacman expands $repo and $arch
  # Current mirrors serve only when the archive stalls.
  printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$date" > "$MIRRORLIST"
  cat >> "$MIRRORLIST" <<'MIRRORS'
Server = https://geo.mirror.pkgbuild.com/$repo/os/$arch
Server = https://mirror.rackspace.com/archlinux/$repo/os/$arch
MIRRORS
fi
touch "$STATE/retry"
# One snapshot pair around the whole update, so the top bar can undo it.
pre=$(snapper -c root create -t pre -p -c number -d "Before Intent OS update $build" 2>/dev/null || true)
keyring=archlinux-keyring
[[ $(uname -m) == aarch64 ]] && keyring=archlinuxarm-keyring
pacman -Sy --noconfirm --needed "$keyring"
pacman -Su --noconfirm
if [[ -n $pre ]]; then
  post=$(snapper -c root create -t post --pre-number "$pre" -p -c number -d "After Intent OS update $build")
  printf 'PRE=%s\nPOST=%s\nBUILD=%s\nDATE=%s\n' "$pre" "$post" "$build" "$(date '+%a %-d %b %H:%M')" \
    > "$STATE/last-update"
fi
echo "$build" > "$STATE/applied-build"
rm -f "$STATE/retry"
log "done"
