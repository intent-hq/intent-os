[Unit]
Description=Download the FaceTime HD camera firmware from Apple
ConditionPathExists=!/usr/lib/firmware/facetimehd/firmware.bin
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/lib/intent-os/hw/facetimehd-firmware
# Retry on a later boot if the network or Apple's server was not reachable.
SuccessExitStatus=0

[Install]
WantedBy=multi-user.target
