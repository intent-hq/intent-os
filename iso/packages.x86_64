# Complete package list for the live installer (built from archiso's
# baseline profile). Keep it to what intent-os-install uses.
base
linux-t2
# T2 Macs: copies Wi-Fi firmware from the macOS volume before the disk is erased.
apple-bcm-firmware-fetcher
mkinitcpio
mkinitcpio-archiso
syslinux
arch-install-scripts
btrfs-progs
dosfstools
gptfdisk
networkmanager
wpa_supplicant
jq
# Wi-Fi only: prebuilt MacBook Air wl driver plus Intel, Atheros and
# MediaTek Wi-Fi firmware (intent-os-live, built in build/in-container.sh),
# and the small Broadcom and Realtek sets.
intent-os-live
linux-firmware-broadcom
linux-firmware-realtek
