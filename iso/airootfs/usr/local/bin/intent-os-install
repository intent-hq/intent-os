#!/bin/bash
# Intent OS installer. Erases one disk and installs Intent OS. Packages come
# from the Arch snapshot this image was tested with and the signed intent-os
# repo, so the installer needs a network connection.
#
# Unattended mode (tests): QEMU passes KEY=VALUE lines through fw_cfg
# opt/intent-os/install with DISK, PIN, TIMEZONE, AFTER=poweroff|reboot, and
# optional HW (a hardware package to force, so tests cover its install), and
# optional REPO (an intent-os repo URL, so tests install the packages under test).
#
# Image mode (build/make-vm-image.sh): INTENT_OS_INSTALL_CONFIG names a file with
# the same keys plus IMAGE=1, ESP_DEV and ROOT_DEV (pre-made partitions) and
# FIRSTBOOT=1 (no PIN yet; the device asks for it on first boot), and
# BOOTSTRAP=1 (install only a minimal system plus intent-os-bootstrap; the
# device downloads the rest of Intent OS on first boot).
set -euo pipefail

OWNER=intent
HOSTNAME_DEFAULT=intent-os
FWCFG=/sys/firmware/qemu_fw_cfg/by_name/opt/intent-os/install/raw
INSTALL_CONF=/etc/intent-os/pacman-install.conf
MNT=/mnt
BTRFS_OPTS=noatime,compress=zstd:1

AUTO=0 DISK="" PIN="" TIMEZONE="" AFTER=reboot HW="" REPO=""
IMAGE=0 FIRSTBOOT=0 BOOTSTRAP=0 ESP_DEV="" ROOT_DEV="" CONSOLE="" ESP_VOLID=""
APPLE_SILICON=intent-os-hw-apple-silicon
ARCH=$(uname -m)

say() { printf '\n\033[1m%s\033[0m\n' "$*"; }
die() { printf '\n\033[31mError:\033[0m %s\n' "$*" >&2; exit 1; }
# A failed unattended run (the CI boot test) powers off at once instead of waiting.
on_exit() {
  local rc=$?
  if (( rc != 0 && AUTO && !IMAGE )); then echo "INTENT_OS_INSTALL_FAILED"; sync; systemctl poweroff; fi
}
trap on_exit EXIT

load_auto_config() {
  local source=$FWCFG
  if [[ -n ${INTENT_OS_INSTALL_CONFIG:-} ]]; then
    source=$INTENT_OS_INSTALL_CONFIG
  else
    modprobe -q qemu_fw_cfg 2>/dev/null || true
  fi
  [[ -r $source ]] || return 0
  AUTO=1
  local key value
  while IFS='=' read -r key value; do
    case $key in
      DISK) [[ $value =~ ^/dev/[a-z0-9]+$ ]] && DISK=$value ;;
      PIN) [[ $value =~ ^[0-9]{4,12}$ ]] && PIN=$value ;;
      TIMEZONE) [[ -f /usr/share/zoneinfo/$value ]] && TIMEZONE=$value ;;
      AFTER) [[ $value =~ ^(poweroff|reboot)$ ]] && AFTER=$value ;;
      HW) [[ $value =~ ^intent-os-hw-[a-z0-9-]+$ ]] && HW=$value ;;
      REPO) [[ $value =~ ^(https?|file)://[A-Za-z0-9.:/_-]+$ ]] && REPO=$value ;;
      IMAGE) [[ $value == 1 ]] && IMAGE=1 ;;
      FIRSTBOOT) [[ $value == 1 ]] && FIRSTBOOT=1 ;;
      BOOTSTRAP) [[ $value == 1 ]] && BOOTSTRAP=1 FIRSTBOOT=1 ;;
      ESP_DEV) [[ $value =~ ^/dev/[a-z0-9]+$ ]] && ESP_DEV=$value ;;
      ROOT_DEV) [[ $value =~ ^/dev/[a-z0-9]+$ ]] && ROOT_DEV=$value ;;
      ESP_VOLID) [[ $value =~ ^[0-9A-Fa-f]{8}$ ]] && ESP_VOLID=$value ;;
      CONSOLE) [[ $value =~ ^[A-Za-z0-9,=\ ]+$ ]] && CONSOLE=$value ;;
    esac
  done < "$source"
  [[ -n $DISK || -n $ROOT_DEV ]] || die "unattended config needs DISK (or ESP_DEV and ROOT_DEV)"
  (( FIRSTBOOT )) || [[ -n $PIN ]] || die "unattended config needs PIN (or FIRSTBOOT=1)"
  if (( IMAGE )); then
    # Write the image at maximum compression; the device mounts with the
    # normal fast level afterwards (fstab is rewritten in install_packages).
    BTRFS_OPTS=noatime,compress-force=zstd:15
    return 0
  fi
  TIMEZONE=${TIMEZONE:-UTC}
  local serial
  for serial in /dev/ttyS0 /dev/ttyAMA0; do
    if [[ -w $serial ]] && stty -F "$serial" >/dev/null 2>&1; then
      exec > >(tee "$serial") 2>&1
      break
    fi
  done
}

check_uefi() {
  [[ -d /sys/firmware/efi/efivars ]] || die "boot this USB stick in UEFI mode (hold Option at the chime and pick EFI Boot)"
}

online() {
  if command -v nmcli >/dev/null; then
    [[ $(nmcli -t -f CONNECTIVITY general 2>/dev/null) == full ]]
  else
    curl -fsS --max-time 10 -o /dev/null https://github.com
  fi
}

# Some Wi-Fi chips (Broadcom brcmfmac in many Macs) fail on WPA3 when a router
# offers WPA2 and WPA3 together. If the normal connect fails, drop the failed
# profile and try again with WPA2 (WPA-PSK) only.
wifi_connect() {
  local ssid=$1 pw=$2 err
  if err=$(nmcli dev wifi connect "$ssid" ${pw:+password "$pw"} 2>&1 >/dev/null); then
    return 0
  fi
  nmcli -t -f NAME connection show | grep -Fx -- "$ssid" | while read -r _; do
    nmcli connection delete id "$ssid" >/dev/null 2>&1 || true
  done
  [[ -n $pw ]] || { echo "$err"; return 1; }
  nmcli connection add type wifi con-name "$ssid" ssid "$ssid" \
    wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$pw" >/dev/null 2>&1 &&
    nmcli connection up id "$ssid" >/dev/null 2>&1 && return 0
  nmcli connection delete id "$ssid" >/dev/null 2>&1 || true
  echo "$err"
  return 1
}

setup_network() {
  online && { say "Network: connected."; return; }
  say "Network"
  echo "The installer downloads Intent OS, so it needs a network."
  local ssids=() i choice pw
  while :; do
    mapfile -t ssids < <(nmcli -t -f SSID dev wifi list --rescan yes 2>/dev/null | awk 'NF && !seen[$0]++' | head -n 15)
    if (( ${#ssids[@]} == 0 )); then
      echo "No Wi-Fi networks found."
    else
      for i in "${!ssids[@]}"; do printf '  %2d) %s\n' $((i + 1)) "${ssids[$i]}"; done
    fi
    read -rp "Network number, or r to rescan: " choice
    [[ $choice == r ]] && continue
    if ! [[ $choice =~ ^[0-9]+$ ]] || (( choice < 1 || choice > ${#ssids[@]} )); then
      continue
    fi
    local ssid=${ssids[$((choice - 1))]}
    read -rsp "Password for $ssid (empty if open): " pw; echo
    if wifi_connect "$ssid" "$pw"; then
      sleep 2
      online && { echo "Connected."; return; }
    fi
    echo "Could not connect. Check the password and try again."
  done
}

live_disk() {
  findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null | sed -E 's/p?[0-9]+$//'
}

pick_disk() {
  local live disks=() i choice
  live=$(live_disk || true)
  mapfile -t disks < <(lsblk -dpno NAME,TYPE,RM | awk '$2 == "disk" {print $1}' | grep -vxF "${live:-none}" | grep -Ev '/dev/(loop|sr|zram)')
  (( ${#disks[@]} )) || die "no disk found"
  say "Disk"
  for i in "${!disks[@]}"; do
    printf '  %d) %s\n' $((i + 1)) "$(lsblk -dno NAME,SIZE,MODEL "${disks[$i]}")"
  done
  while :; do
    read -rp "Disk number to erase: " choice
    [[ $choice =~ ^[0-9]+$ ]] && (( choice >= 1 && choice <= ${#disks[@]} )) && break
  done
  DISK=${disks[$((choice - 1))]}
}

pick_pin() {
  local a b
  say "PIN"
  echo "Use 4 to 12 digits. You enter it to unlock this device."
  while :; do
    read -rsp "PIN: " a; echo
    [[ $a =~ ^[0-9]{4,12}$ ]] || { echo "Use 4 to 12 digits."; continue; }
    read -rsp "Confirm PIN: " b; echo
    [[ $a == "$b" ]] && break
    echo "The PINs do not match."
  done
  PIN=$a
}

pick_timezone() {
  local tz
  say "Time zone"
  while :; do
    read -rp "Time zone, for example America/Los_Angeles [UTC]: " tz
    tz=${tz:-UTC}
    [[ -f /usr/share/zoneinfo/$tz ]] && break
    echo "Unknown time zone."
  done
  TIMEZONE=$tz
}

confirm_erase() {
  say "Ready"
  echo "Disk:      $DISK ($(lsblk -dno SIZE,MODEL "$DISK"))"
  echo "Time zone: $TIMEZONE"
  echo
  echo "Everything on $DISK will be erased."
  local answer
  read -rp "Type erase to install: " answer
  [[ $answer == erase ]] || die "cancelled"
}

part() {
  [[ $DISK =~ [0-9]$ ]] && echo "${DISK}p$1" || echo "${DISK}$1"
}

partition() {
  umount -R "$MNT" 2>/dev/null || true
  if [[ -n $ROOT_DEV ]]; then
    say "Formatting $ESP_DEV and $ROOT_DEV"
    ESP=$ESP_DEV ROOT=$ROOT_DEV
  else
    say "Partitioning $DISK"
    wipefs -af "$DISK"
    sgdisk --zap-all "$DISK"
    sgdisk -n1:0:+1G -t1:ef00 -c1:EFI -n2:0:0 -t2:8300 -c2:intent-os "$DISK"
    partx -u "$DISK" 2>/dev/null || true
    udevadm settle
    ESP=$(part 1) ROOT=$(part 2)
  fi
  mkfs.fat -F32 -n EFI ${ESP_VOLID:+-i "$ESP_VOLID"} "$ESP"
  mkfs.btrfs -f -L intent-os "$ROOT"

  mount "$ROOT" "$MNT"
  local sv
  for sv in @ @home @snapshots @log @pkg; do btrfs subvolume create "$MNT/$sv"; done
  umount "$MNT"
  mount -o "$BTRFS_OPTS,subvol=@" "$ROOT" "$MNT"
  mkdir -p "$MNT"/{efi,home,.snapshots,var/log,var/cache/pacman/pkg}
  mount -o "$BTRFS_OPTS,subvol=@home" "$ROOT" "$MNT/home"
  mount -o "$BTRFS_OPTS,subvol=@snapshots" "$ROOT" "$MNT/.snapshots"
  mount -o "$BTRFS_OPTS,subvol=@log" "$ROOT" "$MNT/var/log"
  mount -o "$BTRFS_OPTS,subvol=@pkg" "$ROOT" "$MNT/var/cache/pacman/pkg"
  mount -o umask=0077 "$ESP" "$MNT/efi"
}

# Apple T2 bridge (PCI 106b:1801): Intel Macs from 2018 to 2020.
is_t2() {
  local d
  for d in /sys/bus/pci/devices/*; do
    [[ $(cat "$d/vendor" 2>/dev/null) == 0x106b && $(cat "$d/device" 2>/dev/null) == 0x1801 ]] && return 0
  done
  return 1
}

# T2 Wi-Fi firmware is Apple's and ships only with macOS. Copy it from the
# macOS volume now, before the disk is erased; it also enables Wi-Fi here.
T2_FIRMWARE_STAMP=/run/intent-os-t2-firmware
fetch_t2_firmware() {
  is_t2 || return 0
  say "T2 Mac: copying the Wi-Fi firmware from macOS"
  touch "$T2_FIRMWARE_STAMP"
  if ! apple-bcm-firmware-fetcher; then
    echo "Could not copy the Wi-Fi firmware (is macOS still on this disk?)."
    echo "Wi-Fi will not work. Use USB Ethernet or a phone (USB tethering) to install."
  fi
}

copy_t2_firmware() {
  [[ -e $T2_FIRMWARE_STAMP ]] || return 0
  local f
  while read -r f; do
    install -Dm644 "$f" "$MNT$f"
  done < <(find /usr/lib/firmware/brcm -type f -newer "$T2_FIRMWARE_STAMP")
}

hardware_packages() {
  local product
  [[ -n $HW ]] && { echo "$HW"; return; }
  is_t2 && { echo intent-os-hw-t2; return; }
  product=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)
  case $product in
    MacBookAir6,1|MacBookAir6,2) echo intent-os-hw-macbookair6 ;;
  esac
}

keyring_name() {
  [[ $ARCH == aarch64 ]] && echo archlinuxarm || echo archlinux
}

trust_intent_os_key() {
  if [[ ! -s /etc/pacman.d/gnupg/pubring.gpg ]]; then
    pacman-key --init >/dev/null
    pacman-key --populate "$(keyring_name)" >/dev/null
  fi
  [[ -f /etc/intent-os/intent-os-trusted ]] || return 0
  local fpr
  fpr=$(cut -d: -f1 /etc/intent-os/intent-os-trusted)
  pacman-key --add /etc/intent-os/intent-os.gpg >/dev/null
  pacman-key --lsign-key "$fpr" >/dev/null
}

# Asahi builds m1n1's second stage (m1n1, device trees, U-Boot) into the ESP
# from a pacman hook. Without a device tree (image build) it finds the ESP at
# /boot/efi when /boot/efi/.builder exists; on the Mac it finds it by itself.
prepare_asahi_esp() {
  mkdir -p "$MNT/boot/efi" "$MNT/efi/m1n1"
  mount --bind "$MNT/efi" "$MNT/boot/efi"
  touch "$MNT/efi/.builder"
}

finish_asahi_esp() {
  arch-chroot "$MNT" update-m1n1
  [[ -s $MNT/efi/m1n1/boot.bin ]] || die "update-m1n1 did not write m1n1/boot.bin"
  rm -f "$MNT/efi/.builder"
  umount "$MNT/boot/efi"
}

install_packages() {
  say "Downloading and installing Intent OS"
  local hw conf=$INSTALL_CONF
  hw=$(hardware_packages)
  [[ -n $hw ]] && echo "Hardware support: $hw"
  if [[ -n $REPO ]]; then
    conf=$(mktemp)
    sed "s|^Server = https://github.com/intent-hq/intent-os/.*|Server = $REPO|" "$INSTALL_CONF" > "$conf"
    [[ $REPO == file://* ]] && sed -i 's|^SigLevel = Required DatabaseRequired$|SigLevel = Optional TrustAll|' "$conf"
  fi
  trust_intent_os_key
  local packages=(intent-os-base intent-os-session intent-os-update)
  # Generic arm64 (UTM, UEFI boards) runs Arch Linux ARM's kernel; Apple
  # silicon gets the Asahi kernel from its hardware package.
  if [[ $ARCH == aarch64 && $hw != "$APPLE_SILICON" ]]; then
    packages+=(linux-aarch64 intent-os-bootstrap)
  elif (( FIRSTBOOT )); then
    packages+=(intent-os-bootstrap)  # the first-boot PIN and time zone screen
  fi
  [[ $hw == "$APPLE_SILICON" ]] && prepare_asahi_esp
  if (( BOOTSTRAP )); then
    packages=(intent-os-bootstrap)
    if [[ $ARCH == aarch64 ]]; then packages+=(linux-aarch64 archlinuxarm-keyring); else packages+=(linux); fi
    hw=""
  fi
  # Mirrors stall now and then. Downloads stay in the new root's package
  # cache, so each retry fetches only what is still missing.
  local try
  for try in 1 2 3; do
    # shellcheck disable=SC2086
    pacstrap -C "$conf" -G -M "$MNT" "${packages[@]}" $hw && break
    (( try == 3 )) && die "Could not download Intent OS. Check the network, then run the installer again."
    echo "Download failed. Trying again in 30 seconds ($try of 3)."
    sleep 30
  done
  if (( IMAGE )); then
    # Built in a container: keep every driver, not just the build host's.
    # Asahi's hook loads the Wi-Fi and other firmware from the ESP.
    local asahi=""
    [[ $hw == "$APPLE_SILICON" ]] && asahi=" asahi"
    mkdir -p "$MNT/etc/mkinitcpio.conf.d"
    echo "HOOKS=(base$asahi udev modconf kms keyboard keymap consolefont block filesystems)" \
      > "$MNT/etc/mkinitcpio.conf.d/zz-intent-os-image.conf"
  fi
  [[ $hw == "$APPLE_SILICON" ]] && finish_asahi_esp
  # In a container (image builds) udev has no UUIDs for the loop devices, so
  # genfstab writes /dev/loopN, and it copies the build host's active swap.
  # Name the partitions by UUID read from their superblocks, and drop swap
  # entries (Intent OS swaps to zram).
  local root_uuid esp_uuid
  root_uuid=$(blkid -p -s UUID -o value "$ROOT")
  esp_uuid=$(blkid -p -s UUID -o value "$ESP")
  [[ -n $root_uuid && -n $esp_uuid ]] || die "Could not read the partition UUIDs."
  genfstab -U "$MNT" | sed -E 's/subvolid=[0-9]+,?//; s/,+([[:space:]])/\1/' |
    awk -v root="$ROOT" -v esp="$ESP" -v ru="UUID=$root_uuid" -v eu="UUID=$esp_uuid" '
      /^[[:space:]]*#/ || NF < 3 { print; next }
      $3 == "swap" { next }
      $1 == root { $1 = ru } $1 == esp { $1 = eu } { print }' >> "$MNT/etc/fstab"
  sed -i 's/compress-force=zstd:15/compress=zstd:1/' "$MNT/etc/fstab"
  if grep -Eq '^/dev/loop' "$MNT/etc/fstab"; then die "fstab still names a loop device."; fi
  # The Asahi installer grows the root partition; grow the filesystem to match.
  if [[ $hw == "$APPLE_SILICON" ]]; then
    sed -i -E '/[[:space:]]\/[[:space:]]+btrfs/ s/(subvol=\/@)/\1,x-systemd.growfs/' "$MNT/etc/fstab"
  fi
}

configure_pacman() {
  local conf=$MNT/etc/pacman.conf
  if [[ $(uname -m) == aarch64 ]]; then
    # The stock ARM config enables aur, but our install repos omit its database.
    sed -i '/^\[aur\]$/,/^$/d' "$conf"
  fi
  if [[ $(hardware_packages) == "$APPLE_SILICON" ]]; then
    # Asahi's kernel, firmware tools and Mesa come before Arch Linux ARM's.
    # shellcheck disable=SC2016 # pacman expands $arch
    echo 'Server = https://github.com/asahi-alarm/asahi-alarm/releases/download/$arch' \
      > "$MNT/etc/pacman.d/mirrorlist.asahi-alarm"
    sed -i '/^\[core\]/i [asahi-alarm]\nInclude = /etc/pacman.d/mirrorlist.asahi-alarm\n' "$conf"
  fi
  # x86_64 follows the tested Arch Linux Archive snapshot; Arch Linux ARM has
  # no archive, so aarch64 keeps its normal mirrors.
  if [[ -f /etc/intent-os/mirrorlist ]]; then
    install -Dm644 /etc/intent-os/mirrorlist "$MNT/etc/pacman.d/intent-os-mirrorlist"
    sed -i 's|^Include = /etc/pacman.d/mirrorlist|Include = /etc/pacman.d/intent-os-mirrorlist|' "$conf"
  fi
  if (( BOOTSTRAP )) && [[ ! -f /etc/intent-os/intent-os.gpg ]]; then
    # Unsigned local build: first boot still needs the intent-os repo.
    cat >> "$conf" <<'EOF'

[intent-os]
SigLevel = Optional TrustAll
Server = https://github.com/intent-hq/intent-os/releases/download/repo-$arch
EOF
  elif [[ -f /etc/intent-os/intent-os.gpg ]]; then
    install -Dm644 /etc/intent-os/intent-os.gpg "$MNT/usr/share/pacman/keyrings/intent-os.gpg"
    install -Dm644 /etc/intent-os/intent-os-trusted "$MNT/usr/share/pacman/keyrings/intent-os-trusted"
    cat >> "$conf" <<'EOF'

[intent-os]
SigLevel = Required DatabaseRequired
Server = https://github.com/intent-hq/intent-os/releases/download/repo-$arch
EOF
  else
    cat >> "$conf" <<'EOF'

# Intent OS packages update from a signed repo. This image was built without
# a signing key, so only Arch packages update automatically.
#[intent-os]
#SigLevel = Required DatabaseRequired
#Server = https://github.com/intent-hq/intent-os/releases/download/repo-$arch
EOF
  fi
}

configure_system() {
  say "Configuring"
  local cmdline="quiet loglevel=3"
  if [[ -n $CONSOLE ]]; then
    cmdline+=" $CONSOLE"
  elif (( AUTO && ! IMAGE )); then
    if [[ $ARCH == aarch64 ]]; then
      cmdline+=" console=ttyAMA0,115200 console=tty0"
    else
      cmdline+=" console=ttyS0,115200 console=tty0"
    fi
  fi
  # The Chuwi MiniBook X has a portrait panel mounted sideways. sway follows the
  # kernel's panel orientation (keep in sync with the installer's GRUB menu).
  if [[ $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) == CHUWI* ]] \
    && [[ $(cat /sys/class/dmi/id/product_name 2>/dev/null) =~ ^MiniBook\ X\ *$ ]]; then
    cmdline+=" video=DSI-1:panel_orientation=right_side_up fbcon=rotate:1"
  fi
  if [[ $(hardware_packages) == intent-os-hw-t2 ]]; then
    cmdline+=" intel_iommu=on iommu=pt pm_async=off"
    # Boot the T2 kernel by default; Arch's kernel stays as a fallback.
    echo 'GRUB_TOP_LEVEL="/boot/vmlinuz-linux-t2"' >> "$MNT/etc/default/grub"
  fi
  echo "$HOSTNAME_DEFAULT" > "$MNT/etc/hostname"
  echo "KEYMAP=us" > "$MNT/etc/vconsole.conf"
  echo "LANG=en_US.UTF-8" > "$MNT/etc/locale.conf"
  sed -i 's/^#en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' "$MNT/etc/locale.gen"
  # Phone-like PIN lockout: 10 wrong tries, then wait a minute (default is
  # 3 tries and a 10-minute lockout, which also blocks the right PIN).
  sed -i -E -e 's/^#? *deny *=.*/deny = 10/' -e 's/^#? *unlock_time *=.*/unlock_time = 60/' \
    "$MNT/etc/security/faillock.conf" 2>/dev/null || true
  sed -i -E \
    -e 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="Intent OS"/' \
    -e "s/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT=\"$cmdline\"/" \
    "$MNT/etc/default/grub"
  sed -i 's/^#\?GRUB_BTRFS_SUBMENUNAME=.*/GRUB_BTRFS_SUBMENUNAME="Intent OS snapshots"/' \
    "$MNT/etc/default/grub-btrfs/config" 2>/dev/null || true
  configure_pacman

  local hw_units="" units="greetd fstrim.timer snapper-cleanup.timer grub-btrfsd intent-os-update.timer"
  [[ $(hardware_packages) == intent-os-hw-macbookair6 ]] && hw_units="intent-os-macbookair6-wakeup.service"
  [[ $(hardware_packages) == intent-os-hw-t2 ]] && hw_units="t2fanrd.service tiny-dfr.service"
  [[ $(hardware_packages) == "$APPLE_SILICON" ]] && hw_units="speakersafetyd.service"
  # Bootstrap images enable the rest on first boot, once it is installed.
  (( BOOTSTRAP )) && units="" hw_units=""

  local grub_target=x86_64-efi
  [[ $ARCH == aarch64 ]] && grub_target=arm64-efi
  (( FIRSTBOOT )) && hw_units+=" intent-os-firstboot.service"

  arch-chroot "$MNT" /bin/bash -euo pipefail -s -- "$TIMEZONE" "$OWNER" "$hw_units" "$(keyring_name)" "$grub_target" "$units" "$IMAGE" <<'CHROOT'
tz=$1 owner=$2 hw_units=$3 keyring=$4 grub_target=$5 units=$6 image=$7
ln -sf "/usr/share/zoneinfo/$tz" /etc/localtime
hwclock --systohc || true
locale-gen
useradd -m -G wheel -s /bin/bash "$owner"
passwd -l root
pacman-key --init
pacman-key --populate "$keyring"
[[ -f /usr/share/pacman/keyrings/intent-os.gpg ]] && pacman-key --populate intent-os
[[ -f /usr/share/pacman/keyrings/asahi-alarm.gpg ]] && pacman-key --populate asahi-alarm
mkinitcpio -P
if [[ -f /boot/Image && ! -f /boot/vmlinuz-linux ]]; then ln -f /boot/Image /boot/vmlinuz-linux; fi
# Image builds install onto a bare filesystem image, so grub-install would leave
# out the partition-table module; the real disk is GPT (Apple silicon: GRUB then
# stops at "no such device" in grub rescue).
grub-install --target="$grub_target" --efi-directory=/efi --boot-directory=/boot --removable --no-nvram \
  --modules="part_gpt part_msdos"
mkdir -p /efi/intent-os
grub-editenv /efi/intent-os/grubenv create
grub-editenv /efi/intent-os/grubenv set boot_success=1
if (( image )); then
  # Image builds run in a container: skip the fallback initramfs (first boot
  # rebuilds both) and keep the build host's EFI boot entries out of the menu.
  rm -f /boot/initramfs-*-fallback.img
  chmod -x /etc/grub.d/30_uefi-firmware 2>/dev/null || true
fi
grub-mkconfig -o /boot/grub/grub.cfg
if (( image )); then chmod +x /etc/grub.d/30_uefi-firmware 2>/dev/null || true; fi
grep -q '^[[:space:]]*linux[[:space:]]' /boot/grub/grub.cfg || { echo "error: grub.cfg has no kernel entry" >&2; exit 1; }
# shellcheck disable=SC2086
systemctl enable NetworkManager systemd-resolved systemd-timesyncd $units $hw_units
systemctl set-default graphical.target
CHROOT
  if (( FIRSTBOOT )); then
    install -d "$MNT/var/lib/intent-os"
    touch "$MNT/var/lib/intent-os/firstboot"
  else
    printf '%s:%s\n' "$OWNER" "$PIN" | arch-chroot "$MNT" chpasswd
  fi
}

configure_snapper() {
  say "Setting up snapshots"
  umount "$MNT/.snapshots"
  rmdir "$MNT/.snapshots"
  arch-chroot "$MNT" snapper --no-dbus -c root create-config /
  btrfs subvolume delete "$MNT/.snapshots"
  mkdir "$MNT/.snapshots"
  mount -o "$BTRFS_OPTS,subvol=@snapshots" "$ROOT" "$MNT/.snapshots"
  chmod 750 "$MNT/.snapshots"
  sed -i -E \
    -e 's/^TIMELINE_CREATE=.*/TIMELINE_CREATE="no"/' \
    -e 's/^NUMBER_LIMIT=.*/NUMBER_LIMIT="10"/' \
    -e 's/^NUMBER_LIMIT_IMPORTANT=.*/NUMBER_LIMIT_IMPORTANT="5"/' \
    "$MNT/etc/snapper/configs/root"
  arch-chroot "$MNT" snapper --no-dbus -c root create -d "Intent OS installed" -c number
}

copy_network() {
  local dir=/etc/NetworkManager/system-connections
  compgen -G "$dir/*.nmconnection" >/dev/null || return 0
  install -d -m700 "$MNT$dir"
  cp -a "$dir"/*.nmconnection "$MNT$dir/"
}

finish() {
  ln -sf ../run/systemd/resolve/stub-resolv.conf "$MNT/etc/resolv.conf"
  if (( IMAGE )); then
    # Ship no package downloads, and hand freed blocks back to the sparse
    # disk file so the compressed image stays small.
    rm -rf "$MNT"/var/cache/pacman/pkg/*
    fstrim -v "$MNT" || true
    fstrim -v "$MNT/efi" || true
  fi
  sync
  umount -R "$MNT"
  say "Intent OS is installed."
  (( IMAGE )) && { echo "INTENT_OS_INSTALL_OK"; exit 0; }
  if (( AUTO )); then
    echo "INTENT_OS_INSTALL_OK"
    systemctl "$AFTER"
    exit 0
  fi
  read -rp "Remove the USB stick, then press Enter to restart. " _
  systemctl reboot
}

main() {
  load_auto_config
  clear 2>/dev/null || true
  say "Intent OS installer"
  (( IMAGE )) || check_uefi
  fetch_t2_firmware
  if (( ! AUTO )); then
    setup_network
    pick_disk
    pick_pin
    pick_timezone
    confirm_erase
  fi
  local tries=60
  until online || (( --tries == 0 )); do sleep 1; done
  online || die "no network connection; the installer downloads Intent OS"
  partition
  install_packages
  copy_t2_firmware
  configure_system
  (( BOOTSTRAP )) || configure_snapper
  copy_network
  finish
}

main "$@"
